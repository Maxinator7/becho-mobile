{
  "expo": {
    "name": "Becho",
    "slug": "becho-mobile",
    "version": "0.9.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "in.becho.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Becho uses your photo library so you can add photos and videos to your listings.",
        "NSCameraUsageDescription": "Becho uses the camera so you can take photos of items you sell."
      }
    },
    "android": {
      "package": "in.becho.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-video",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser"
    ]
  }
}
